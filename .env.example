# Copy this file to .env.local (or .env) and fill in the values. .env.local is read first and wins over .env.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Optional server settings (the defaults are shown) -------------------------------------------
# PORT=3000

# Number of reverse proxies in front of the server (nginx, a load balancer: 1). It makes the rate limits
# below apply per visitor. It defaults to 1 on Cloud Run (AI Studio) and to 0 everywhere else; set 0
# explicitly if the server is exposed directly.
# TRUST_PROXY=1

# Rate limits: only requests that cost an upstream call are counted (cached audio is free).
# TTS_UPSTREAM_PER_MINUTE=60            # new audio clips one visitor may request per minute
# TTS_UPSTREAM_GLOBAL_PER_MINUTE=600    # the same, for all visitors together
# LESSON_GENERATIONS_PER_10_MIN=5       # AI lessons one visitor may generate per 10 minutes

# Audio cache sizes (the oldest clips are dropped beyond these limits)
# AUDIO_MEMORY_MAX_ENTRIES=300          # kept in memory
# AUDIO_DISK_MAX_ENTRIES=1500           # kept in .cache/audio
